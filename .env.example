# CG Dev / CG Lab - deployment environment variable template
#
# IMPORTANT:
# - This is a PUBLIC GitHub test repository. Never commit real secrets here.
# - These values belong in the Vercel project cg-lab (deployed from CeciG21/cg-demos).
# - Copy the variable names below into Vercel > cg-lab > Settings > Environment Variables.
# - Fill in secret values ONLY in Vercel (or an ignored .env.local for local development).
#
# Fine-grained GitHub token for CeciG21/demo-test-1 only:
# Repository permissions: Contents read/write and Pull requests read/write.
GITHUB_TOKEN=

# Generate a random secret in Terminal: openssl rand -hex 32
# Enter this same value in the CG Dev Owner access key field.
CG_DEV_ADMIN_KEY=

# Not a secret. Live writes are limited to these repositories.
CG_DEV_ALLOWED_REPOS=CeciG21/demo-test-1

# Optional: AI planning only. The real GitHub Markdown proof does not need an OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep public AI disabled to avoid unrestricted API costs.
CG_DEV_PUBLIC_AI=false
